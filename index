  const tc = $("trace-clear"); if (tc) tc.addEventListener("click", () => { state.trace = [q.target]; state.traceMsg = null; renderMain(); });
}

// ---------- Trace tool ----------
function traceMessage() {
  if (!state.trace) return "";
  const t = tx(), q = state.q, tr = state.trace, end = tr[tr.length - 1];
  if (state.traceMsg && state.traceMsg.bad) return fill(t.traceBad, state.traceMsg.vars);
  if (q.web.level[end] === 0 && tr.length > 1) return fill(t.traceDone, { n: tr.length - 1 });
  if (tr.length === 1) return fill(t.traceStart, { o: esc(nm(q.target)) });
  return fill(t.traceStep, { n: tr.length - 1, c: esc(nm(end)) });
}
function traceTap(id) {
  if (!state.trace) return;
  const q = state.q, tr = state.trace, end = tr[tr.length - 1];
  if (q.web.foods[end].includes(id)) { tr.push(id); state.traceMsg = null; }
  else if (id !== end) state.traceMsg = { bad: true, missId: id, vars: { c: esc(nm(end)), x: esc(nm(id)) } };
  renderMain();
}

// ---------- Checking answers ----------
function checkCalories() {
  const q = state.q, t = tx();
  const raw = q.input.trim().replace(/[,\s]/g, "");
  const num = Number(raw);
  if (raw === "" || !isFinite(num)) { q.fb = { cls: "bad", html: t.needNum }; renderMain(); $("cal-in").focus(); return; }
  checkAnswer(num);
}
function isRight(q, ans) {
  if (q.type === "cal") return Math.abs(ans - q.answer) <= Math.max(1e-9, Math.abs(q.answer) * 1e-6);
  return ans === q.answer;
}
function checkAnswer(ans) {
  const q = state.q, t = tx();
  if (q.solved || (state.mode === "test" && q.tries > 0)) return;
  q.tries++;
  const o = esc(nm(q.target));
  if (isRight(q, ans)) {
    q.solved = true; q.flash = "good";
    if (q.firstTry === null) q.firstTry = true;
    q.fb = { cls: "good", html: t.correct };
    if (state.mode === "test") {
      state.streak++;
      if (state.streak >= 2 && !state.passed) { state.passed = true; confetti(true); }
    } else if (!q.revealed) confetti(false);          // practice: confetti on every correct answer (not after the answer was shown)
    renderMain();
    return;
  }
  // Wrong
  if (q.firstTry === null) q.firstTry = false;
  q.flash = "bad";
  if (q.type !== "cal") q.wrongPicks.push(ans);
  let hint = "";
  if (q.type === "level") hint = fill(ans < q.answer ? t.tooLow : t.tooHigh, { o });
  else if (q.type === "cal") hint = calMissHint(q, ans) || t.hintCal;
  else hint = fill(t.hintDiet, { o });

  if (state.mode === "test") {
    q.fb = { cls: "bad", html: `${t.wrong.split(".")[0]}. ${t.testMiss}` };
    state.streak = 0; q.showExpl = true; q.revealed = true; startWalk();
  } else if (q.tries === 1) {
    q.fb = { cls: "bad", html: `${t.wrong}<span class="hint">${hint}</span>` };
  } else {
    q.fb = { cls: "bad", html: t.wrong };
    q.showExpl = true; q.revealed = true; startWalk();
  }
  renderMain();
}

// Calories: if a wrong answer matches a common mistake, say exactly what happened.
//  1) The number belongs to a DIFFERENT organism on the path (e.g. they kept going down to the producer).
//  2) The number is what you'd get using a SHORTER path (lower level) for one of the organisms.
function calMissHint(q, ans) {
  const t = tx(), web = q.web, same = (x) => Math.abs(x - ans) <= Math.max(1e-9, Math.abs(x) * 1e-6);
  const asked = q.dir === "up" ? q.target : q.anchor;
  const la = web.level[q.anchor], anchorCal = q.dir === "up" ? q.given : q.answer;
  for (const id of q.path) {
    if (id === asked) continue;
    const v = anchorCal / 10 ** (web.level[id] - la);
    if (same(v)) return fill(t.calOtherOrg, { n: fmtNum(ans), x: esc(nm(id)), a: esc(nm(asked)) });
  }
  for (const id of [q.target, q.anchor]) {
    const lo = web.minLevel[id];
    if (lo === web.level[id]) continue;
    const kAlt = id === q.target ? lo - la : web.level[q.target] - lo;
    if (kAlt < 0) continue;
    const v = q.dir === "up" ? q.given / 10 ** kAlt : q.given * 10 ** kAlt;
    if (same(v)) return fill(t.calShortPath, { x: esc(nm(id)), lo, hi: web.level[id] });
  }
  return "";
}

// ---------- Read aloud ----------
function speak() {
  const t = tx();
  if (!("speechSynthesis" in window)) return;
  speechSynthesis.cancel();
  const [a, b] = questionParts(state.q, true);
  const u = new SpeechSynthesisUtterance(`${a} ${b}`);
  u.lang = t.speechLang; u.rate = 0.9;
  const voices = speechSynthesis.getVoices(), prefix = t.speechLang.slice(0, 2);
  const voice = voices.find((v) => v.lang === t.speechLang) || voices.find((v) => v.lang && v.lang.startsWith(prefix));
  if (voice) u.voice = voice;
  else if (voices.length) { state.q.fb = { cls: "bad", html: t.noVoice }; renderMain(); return; }
  speechSynthesis.speak(u);
}

// ---------- Calculator (same as Density Detective) ----------
const calc = { expr: "", result: null };
const CALC_KEYS = ["7", "8", "9", "÷", "4", "5", "6", "×", "1", "2", "3", "−", "0", ".", "=", "+", "C", "⌫", "USE"];
function calcEvaluate(expr) {
  const tokens = expr.match(/\d+\.?\d*|\.\d+|[+−×÷]/g);
  if (!tokens) return null;
  const nums = [], ops = [], prec = { "+": 1, "−": 1, "×": 2, "÷": 2 };
  const apply = () => {
    const b = nums.pop(), a = nums.pop(), op = ops.pop();
    if (a === undefined || b === undefined) throw new Error("bad");
    if (op === "÷" && b === 0) throw new Error("div0");
    nums.push(op === "+" ? a + b : op === "−" ? a - b : op === "×" ? a * b : a / b);
  };
  let expectNum = true;
  for (const tk of tokens) {
    if (prec[tk]) {
      if (expectNum) { if (tk === "−") nums.push(0); else throw new Error("bad"); }
      while (ops.length && prec[ops[ops.length - 1]] >= prec[tk]) apply();
      ops.push(tk); expectNum = true;
    } else { nums.push(parseFloat(tk)); expectNum = false; }
  }
  if (expectNum) throw new Error("bad");
  while (ops.length) apply();
  return nums[0];
}
function calcFormat(n) { return String(Number(n.toPrecision(10))).includes("e") ? fmtNum(n).replace(/,/g, "") : String(Number(n.toPrecision(10))); }
function calcPress(k) {
  const isOp = (c) => "+−×÷".includes(c);
  if (k === "C") { calc.expr = ""; calc.result = null; }
  else if (k === "⌫") { calc.expr = calc.expr.slice(0, -1); calc.result = null; }
  else if (k === "=") { try { const r = calcEvaluate(calc.expr); if (r !== null) calc.result = r; } catch (e) { calc.result = "Error"; } }
  else if (k === "USE") { useCalcResult(); return; }
  else {
    if (calc.result !== null && calc.result !== "Error") calc.expr = isOp(k) ? calcFormat(calc.result) : "";
    else if (calc.result === "Error") calc.expr = "";
    calc.result = null;
    if (isOp(k) && isOp(calc.expr.slice(-1))) calc.expr = calc.expr.slice(0, -1);
    if (k === ".") { const last = calc.expr.split(/[+\−×÷]/).pop(); if (last.includes(".")) return; }
    calc.expr += k;
  }
  renderCalc();
}
function renderCalc() {
  $("calc-expr").textContent = calc.result !== null ? calc.expr + " =" : "";
  $("calc-val").textContent = calc.result === null ? (calc.expr || "0") : calc.result === "Error" ? "Error" : calcFormat(calc.result);
}
function useCalcResult() {
  const val = calc.result !== null && calc.result !== "Error" ? calcFormat(calc.result) : calc.expr;
  if (!val || !/^-?\d*\.?\d+$/.test(val) || !state.q || state.q.type !== "cal") return;
  state.q.input = val;
  const el = $("cal-in"); if (el && !el.disabled) { el.value = val; el.focus(); }
}
function buildCalc() {
  const t = tx();
  $("calc-keys").innerHTML = CALC_KEYS.map((k) => {
    const cls = k === "=" ? "eq" : "+−×÷".includes(k) ? "op" : k === "USE" ? "use" : "";
    const aria = { "÷": "divide", "×": "times", "−": "minus", "+": "plus", "C": "clear", "⌫": "delete", "=": "equals" }[k];
    return `<button type="button" class="${cls}" data-k="${k}" ${aria ? `aria-label="${aria}"` : ""}>${k === "USE" ? t.use : k}</button>`;
  }).join("");
  $("calc-keys").querySelectorAll("button").forEach((b) => {
    b.addEventListener("mousedown", (e) => e.preventDefault());
    b.addEventListener("click", () => calcPress(b.dataset.k));
  });
}

// ---------- Confetti ----------
function confetti(big) {
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  const cv = $("confetti"), ctx = cv.getContext("2d");
  cv.hidden = false; cv.width = innerWidth; cv.height = innerHeight;
  const colors = ["#0a7584", "#3ec1d0", "#f4a23c", "#1d7f47", "#e85d75", "#ffd54a", "#7a3cc4"];
  const bits = Array.from({ length: big ? 180 : 70 }, () => ({
    x: Math.random() * cv.width, y: -20 - Math.random() * cv.height * 0.5,
    w: 6 + Math.random() * 6, h: 8 + Math.random() * 8, vy: 2 + Math.random() * 3, vx: -1.5 + Math.random() * 3,
    r: Math.random() * Math.PI, vr: -0.2 + Math.random() * 0.4, c: pick(colors),
  }));
  const start = performance.now(), dur = big ? 3800 : 2200;
  (function frame(now) {
    ctx.clearRect(0, 0, cv.width, cv.height);
    bits.forEach((b) => { b.x += b.vx; b.y += b.vy; b.r += b.vr;
      ctx.save(); ctx.translate(b.x, b.y); ctx.rotate(b.r); ctx.fillStyle = b.c; ctx.fillRect(-b.w / 2, -b.h / 2, b.w, b.h); ctx.restore(); });
    if (now - start < dur) requestAnimationFrame(frame); else { ctx.clearRect(0, 0, cv.width, cv.height); cv.hidden = true; }
  })(start);
}

// ---------- Settings bar, key, footer ----------
function renderChrome() {
  const t = tx();
  document.documentElement.lang = state.lang;
  $("t-tagline").textContent = t.tagline;
  $("t-mode").textContent = t.mode; $("mode-practice").textContent = t.practice; $("mode-test").textContent = t.test;
  $("t-qtype").textContent = t.qtype; $("q-level").textContent = t.qLevel; $("q-cal").textContent = t.qCal; $("q-diet").textContent = t.qDiet;
  $("t-diff").textContent = t.diff; $("d-easy").textContent = t.easy; $("d-medium").textContent = t.medium; $("d-hard").textContent = t.hard;
  $("t-lang").textContent = t.lang; $("t-help").textContent = t.help; $("key-toggle").textContent = t.key;
  $("new-q").textContent = t.newQ;
  const press = (sel, attr, val) => document.querySelectorAll(sel).forEach((b) => b.setAttribute("aria-pressed", String(b.dataset[attr] === String(val))));
  press("#seg-mode button", "mode", state.mode);
  press("#seg-qtype button", "qtype", state.qtype);
  press("#seg-lang button", "lang", state.lang);
  // Test mode always mixes medium + hard webs, so the size picker is turned off.
  document.querySelectorAll("#seg-diff button").forEach((b) => {
    b.disabled = state.mode === "test";
    b.setAttribute("aria-pressed", String(state.mode === "test" ? b.dataset.diff !== "easy" : b.dataset.diff === state.diff));
  });
  $("key-toggle").setAttribute("aria-pressed", String(state.showKey));

  // Vocabulary key (hidden during a test)
  $("key-card").hidden = !state.showKey;
  $("t-keytitle").textContent = t.keyTitle;
  $("key-body").innerHTML = state.mode === "test" ? `<p class="off">${t.keyOff}</p>` : `
    <div class="arrow-demo"><span>🌿</span><svg width="56" height="14" aria-hidden="true"><path d="M2 7h44" stroke="currentColor" stroke-width="2.5"/><path d="M44 1l10 6-10 6z" fill="currentColor"/></svg><span>🐇</span></div>
    <p style="margin:0 0 8px;font-size:.92rem">${t.keyArrow}</p>
    <dl>${["P", "H", "C", "O"].map((k) => `<dt>${t[k]}</dt><dd>${t[k + "d"]}</dd>`).join("")}</dl>
    <p style="margin:10px 0 4px;font-size:.92rem">${t.keyCount}</p>
    <p style="margin:0;font-size:.92rem">${t.keyRule}</p>
    <table><tbody>${[0, 1, 2, 3].map((n) => `<tr><td>${t.lvlText(n)}</td><td class="n">${fmtNum(10000 / 10 ** n)}</td></tr>`).join("")}</tbody></table>`;

  // Calculator only for calorie questions
  $("calc-card").hidden = state.qtype !== "cal";
  document.querySelector(".wrap").classList.toggle("noside", $("calc-card").hidden && $("key-card").hidden);
  $("t-calc").textContent = t.calc; $("t-usetip").textContent = t.useTip;
  buildCalc();

  // Footer with sources
  const srcList = Object.keys(ECOS).filter((k) => SOURCES[k] && SOURCES[k].length).map((k) =>
    `<li>${esc(ECOS[k][state.lang])}: ${SOURCES[k].map((u) => `<a href="${u}" target="_blank" rel="noopener">${esc(u.replace(/^https?:\/\//, "").slice(0, 60))}</a>`).join(" · ")}</li>`).join("");
  $("foot").innerHTML = `<p>${t.foot}</p><details><summary>${t.srcTitle}</summary><ul>${srcList}</ul></details>`;
}

// ---------- Settings events ----------
document.querySelectorAll("#seg-mode button").forEach((b) => b.addEventListener("click", () => {
  if (state.mode === b.dataset.mode) return;
  state.mode = b.dataset.mode; state.streak = 0; state.passed = false; newQuestion();
}));
document.querySelectorAll("#seg-qtype button").forEach((b) => b.addEventListener("click", () => {
  state.qtype = b.dataset.qtype; savePrefs();
  if (state.mode === "test") { state.streak = 0; state.passed = false; }
  newQuestion();
}));
document.querySelectorAll("#seg-diff button").forEach((b) => b.addEventListener("click", () => {
  state.diff = b.dataset.diff; savePrefs(); newQuestion();
}));
document.querySelectorAll("#seg-lang button").forEach((b) => b.addEventListener("click", () => {
  state.lang = b.dataset.lang; savePrefs(); render();
}));
$("key-toggle").addEventListener("click", () => { state.showKey = !state.showKey; renderChrome(); });
$("new-q").addEventListener("click", () => {
  // In a test, skipping a question you haven't answered breaks the streak (so students can't skip hard ones).
  if (state.mode === "test" && state.q && state.q.tries === 0 && !state.passed) state.streak = 0;
  newQuestion();
});
if ("speechSynthesis" in window) speechSynthesis.getVoices();

// ---------- Start ----------
renderCalc();
newQuestion();

</script>
</body>
