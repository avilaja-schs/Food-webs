function wireMain() {
  const q = state.q;
  document.querySelectorAll("[data-ans]").forEach((b) => b.addEventListener("click", () =>
    checkAnswer(q.type === "level" ? Number(b.dataset.ans) : b.dataset.ans)));
  const inp = $("cal-in");
  if (inp) {
    inp.addEventListener("input", () => (q.input = inp.value));
    inp.addEventListener("keydown", (e) => { if (e.key === "Enter") checkCalories(); });
  }
  const cc = $("cal-check"); if (cc) cc.addEventListener("click", checkCalories);
  const nb = $("next-btn"); if (nb) nb.addEventListener("click", newQuestion);
  const nt = $("new-test"); if (nt) nt.addEventListener("click", () => { state.streak = 0; state.passed = false; newQuestion(); });
