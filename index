}

// ---------- Explanation ----------
function chainText(path) { return path.map((id) => `<strong>${esc(nm(id))}</strong>`).join(" ← "); }
function explanationHTML(q) {
  const t = tx(), web = q.web;
  let h = `<div class="expl"><h3>${t.explTitle}</h3>`;
  if (q.type === "level") {
    const path = state.walk && state.walk.path ? state.walk.path : longestPaths(web, q.target)[0];
    const L = web.level[q.target];
    if (L === 0) h += `<p>${fill(t.eatsNothing, { o: esc(nm(q.target)) })}</p>`;
    else h += `<p>${fill(t.longest, { n: L })}</p><p class="chain">${chainText(path)}</p>`;
    h += `<p><strong>${fill(t.isLevel, { o: esc(nm(q.target)), lvl: t.lvlText(L) })}</strong></p>`;
    if (web.minLevel[q.target] < L) h += `<p class="note">${fill(t.shorter, { n: web.minLevel[q.target], chain: chainText(shortestPath(web, q.target)) })}</p>`;
  } else if (q.type === "cal") {
    const L = web.level[q.target], la = web.level[q.anchor];
    h += `<p>${fill(t.calLevels, { a: esc(nm(q.anchor)), la, o: esc(nm(q.target)), lo: L, k: q.k })}</p>`;
    h += `<p>${fill(q.dir === "up" ? t.calUpWork : t.calDownWork, { k: q.k })}</p>`;
    // Table from the producer up to the target, with calories filled in from the given number
    const anchorCal = q.dir === "up" ? q.given : q.answer;
    const rows = q.path.slice().reverse().map((id) => {
      const lvl = web.level[id], cal = anchorCal / 10 ** (lvl - la);
      const hl = id === q.target || id === q.anchor;
      return `<tr class="${hl ? "hl" : ""}"><td class="n">${lvl}</td><td>${esc(nm(id))}</td><td class="n">${fmtNum(cal)}</td></tr>`;
    }).join("");
    h += `<table><thead><tr><th>${t.level}</th><th>${t.organism}</th><th>${t.cal}</th></tr></thead><tbody>${rows}</tbody></table>`;
    const ops = q.dir === "up" ? `${fmtNum(q.given)} ÷ ${fmtNum(10 ** q.k)}` : `${fmtNum(q.given)} × ${fmtNum(10 ** q.k)}`;
    h += `<p><strong>${ops} = ${fmtNum(q.answer)} ${t.calories}</strong></p>`;
  } else {
    const fs = web.foods[q.target];
    if (!fs.length) h += `<p>${fill(t.eatsNothing, { o: esc(nm(q.target)) })}</p>`;
    else h += `<p>${fill(t.eats, { o: esc(nm(q.target)) })} ${fs.map((f) => `<strong>${esc(nm(f))}</strong> (${web.level[f] === 0 ? t.tagProducer : t.tagAnimal})`).join(", ")}</p>`;
    h += `<p><strong>${fill(t["dietIs" + q.answer], { o: esc(nm(q.target)) })}</strong></p>`;
  }
  return h + `</div>`;
}

// Start the step-by-step highlight on the picture
let walkTimer = null;
function startWalk() {
  const q = state.q, web = q.web, t = tx();
  clearInterval(walkTimer);
  state.trace = null; state.traceMsg = null;
  if (q.type === "diet") {
    state.walk = { kind: "diet", step: 0, total: web.foods[q.target].length };
  } else {
    const path = q.type === "cal" ? q.path : pick(longestPaths(web, q.target));
    const labels = path.map((id) => (q.type === "cal"
      ? fmtNum((q.dir === "up" ? q.given : q.answer) / 10 ** (web.level[id] - web.level[q.anchor]))
      : t.lvlBig(web.level[id])));
    state.walk = { kind: "path", path, labels, step: 0, total: path.length - 1 };
  }
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduce) { state.walk.step = state.walk.total; return; }
  walkTimer = setInterval(() => {
    if (!state.walk || state.walk.step >= state.walk.total) { clearInterval(walkTimer); return; }
    state.walk.step++; renderWeb();
  }, 700);
}

