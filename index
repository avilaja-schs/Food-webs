   • CALORIES use the same levels and the 10% rule: up one level = ÷10, down one level = ×10.
   • DIET TYPE is read from the arrows pointing INTO the organism in THIS web:
     none = Producer, only producers = Herbivore, only animals = Carnivore, both = Omnivore.
   • The picture is laid out fresh (randomly) every time, so students can't memorize
     positions, and rows do NOT line up with levels (that would give the answer away).
   ===================================================================== */

// ---------- Small helpers ----------
const $ = (id) => document.getElementById(id);
const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];
const randInt = (lo, hi) => lo + Math.floor(Math.random() * (hi - lo + 1));
function shuffle(arr) { const a = arr.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; }
function fill(str, vars) { return str.replace(/\{(\w+)\}/g, (m, k) => (vars[k] !== undefined ? vars[k] : m)); }
function esc(s) { return String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c])); }
const tx = () => T[state.lang];
const nm = (id) => ORGS[id][state.lang] || ORGS[id].en;    // organism name in current language

// Numbers: commas for thousands, no scientific notation for tiny decimals
function fmtNum(x) {
  x = Number(x.toPrecision(12));
  if (x >= 1) return x.toLocaleString("en-US", { maximumFractionDigits: 6 });
  return x.toFixed(10).replace(/0+$/, "").replace(/\.$/, "");
}

// ---------- Pictures: custom drawings + recolor filters go into the hidden sprite ----------
(function buildSprite() {
  const defs = $("sprite-defs");
  let h = Object.entries(CUSTOM).map(([k, body]) => `<symbol id="ico-${k}" viewBox="0 0 36 36">${body}</symbol>`).join("");
  const tints = new Set(Object.values(ORGS).map((o) => o.tint).filter(Boolean));
  const F = (id, inner) => `<filter id="tint-${id}" color-interpolation-filters="sRGB">${inner}</filter>`;
  for (const tn of tints) {
    if (tn === "gray") h += F(tn, `<feColorMatrix type="saturate" values="0.12"/>`);
    else if (tn === "dark") h += F(tn, `<feColorMatrix type="saturate" values="0.1"/><feComponentTransfer><feFuncR type="linear" slope="0.42"/><feFuncG type="linear" slope="0.42"/><feFuncB type="linear" slope="0.48"/></feComponentTransfer>`);
    else if (tn === "light") h += F(tn, `<feColorMatrix type="saturate" values="0.08"/><feComponentTransfer><feFuncR type="linear" slope="0.55" intercept="0.45"/><feFuncG type="linear" slope="0.55" intercept="0.45"/><feFuncB type="linear" slope="0.55" intercept="0.47"/></feComponentTransfer>`);
    else if (tn === "brown") h += F(tn, `<feColorMatrix type="matrix" values="0.393 0.769 0.189 0 0 0.349 0.686 0.168 0 0 0.272 0.534 0.131 0 0 0 0 0 1 0"/><feComponentTransfer><feFuncR type="linear" slope="0.85"/><feFuncG type="linear" slope="0.75"/><feFuncB type="linear" slope="0.65"/></feComponentTransfer>`);
    else if (/^h-?\d+$/.test(tn)) h += F(tn, `<feColorMatrix type="hueRotate" values="${tn.slice(1)}"/>`);
  }
  defs.insertAdjacentHTML("beforeend", h);
})();

// ---------- Turn the WEBS list into something the app can calculate with ----------
function buildWeb(w) {
  const edges = w.eats.trim().split(/\s+/).map((pair) => pair.split(">"));
  const nodes = [];
  const foods = {}, eaters = {};
  for (const [f, e] of edges) {
    for (const id of [f, e]) {
      if (!ORGS[id]) console.warn(`Food web ${w.id}: unknown organism "${id}"`);
      if (!nodes.includes(id)) { nodes.push(id); foods[id] = []; eaters[id] = []; }
    }
    foods[e].push(f); eaters[f].push(e);
  }
  // Level = longest path back to a producer. Computed with memory + loop detection.
  const level = {}, visiting = new Set();
  let hasLoop = false;
  function lv(id) {
    if (level[id] !== undefined) return level[id];
    if (visiting.has(id)) { hasLoop = true; return 0; }
    visiting.add(id);
    const L = foods[id].length ? 1 + Math.max(...foods[id].map(lv)) : 0;
    visiting.delete(id);
    return (level[id] = L);
  }
  nodes.forEach(lv);
  // Shortest path back to a producer (to warn students about the "trap" path)
  const minLevel = {};
  function mn(id) {
    if (minLevel[id] !== undefined) return minLevel[id];
    return (minLevel[id] = foods[id].length ? 1 + Math.min(...foods[id].map(mn)) : 0);
  }
  if (!hasLoop) nodes.forEach(mn);
  return { ...w, edges, nodes, foods, eaters, level, minLevel, hasLoop,
           producers: nodes.filter((id) => foods[id].length === 0),
           maxLevel: Math.max(...nodes.map((id) => level[id])) };
}
const ALL_WEBS = WEBS.map(buildWeb).filter((w) => {
  if (w.hasLoop) console.warn(`Food web ${w.id} has a loop and was skipped.`);
  return !w.hasLoop;
});

// All longest paths from an organism back to a producer: [target, food, food's food, ..., producer]
function longestPaths(web, id) {
  if (web.level[id] === 0) return [[id]];
  const out = [];
  for (const f of web.foods[id]) if (web.level[f] === web.level[id] - 1) for (const p of longestPaths(web, f)) out.push([id, ...p]);
  return out;
}
function shortestPath(web, id) {
  if (web.foods[id].length === 0) return [id];
  const f = web.foods[id].find((x) => web.minLevel[x] === web.minLevel[id] - 1);
  return [id, ...shortestPath(web, f)];
}
function dietOf(web, id) {
  const fs = web.foods[id];
  if (!fs.length) return "P";
  const prod = fs.filter((f) => web.level[f] === 0).length;
  if (prod === fs.length) return "H";
  if (prod === 0) return "C";
  return "O";
}

// ---------- Layout: place organisms on a staggered grid, then improve it ----------
// Cost = arrow crossings + arrows pointing downward + arrows passing behind pictures + long arrows.
const CW = 190, RH = 150, PAD = 95;
function layoutWeb(web) {
  const R = web.diff === "easy" ? 3 : web.diff === "medium" ? 4 : 5;  // rows (fewer rows than levels in harder webs)
  const ids = web.nodes, N = ids.length, idx = {}; ids.forEach((id, i) => (idx[id] = i));
  const isProd = ids.map((id) => web.producers.includes(id));
  const nProd = isProd.filter(Boolean).length;
  const E = web.edges.length, EF = web.edges.map(([f]) => idx[f]), EE = web.edges.map(([, e]) => idx[e]);
  const dense = E / N > 1.8 ? 1 : 0;                                     // crowded webs get one extra column
  const C = Math.max(nProd, Math.ceil((N - nProd) / (R - 1)) + 1 + dense);
  const sx = (r, c) => PAD + c * CW + (r % 2 ? CW / 2 : 0), sy = (r) => PAD - 20 + (R - 1 - r) * RH;

  // Each organism sits in a grid slot. row[i], col[i] = slot of organism i; grid[r*C+c] = organism index or -1.
  const row = new Int16Array(N), col = new Int16Array(N), X = new Float64Array(N), Y = new Float64Array(N);
  const grid = new Int16Array(R * C);
  const place = (i, r, c) => { row[i] = r; col[i] = c; X[i] = sx(r, c); Y[i] = sy(r); grid[r * C + c] = i; };

  const orient = (ax, ay, bx, by, cx, cy) => Math.sign((bx - ax) * (cy - ay) - (by - ay) * (cx - ax));
  const distSeg = (px, py, ax, ay, bx, by) => {
    const dx = bx - ax, dy = by - ay, L2 = dx * dx + dy * dy;
    let t = L2 ? ((px - ax) * dx + (py - ay) * dy) / L2 : 0; t = t < 0 ? 0 : t > 1 ? 1 : t;
    return Math.hypot(px - (ax + t * dx), py - (ay + t * dy));
  };
  // Cost pieces (lower = better picture):
  const tEdge = (e) => {                                   // eaters should usually sit above their food; short arrows
    const dr = row[EE[e]] - row[EF[e]];
    return (dr < 0 ? 7 * -dr : dr === 0 ? 2 : 0) + 0.25 * Math.hypot(X[EE[e]] - X[EF[e]], Y[EE[e]] - Y[EF[e]]) / CW;
  };
  const tEN = (e, n) => {                                  // arrow passing behind a picture or its name tag
    if (n === EF[e] || n === EE[e]) return 0;
    const ax = X[EF[e]], ay = Y[EF[e]], bx = X[EE[e]], by = Y[EE[e]];
    const d = distSeg(X[n], Y[n], ax, ay, bx, by);
    return (d < 58 ? 40 : d < 80 ? 5 : 0) + (distSeg(X[n], Y[n] + 54, ax, ay, bx, by) < 34 ? 25 : 0);
  };
  const tCR = (e, g) => {                                  // two arrows crossing
    const a = EF[e], b = EE[e], c = EF[g], d = EE[g];
    if (a === c || a === d || b === c || b === d) return 0;
    return orient(X[a], Y[a], X[b], Y[b], X[c], Y[c]) * orient(X[a], Y[a], X[b], Y[b], X[d], Y[d]) < 0 &&
           orient(X[c], Y[c], X[d], Y[d], X[a], Y[a]) * orient(X[c], Y[c], X[d], Y[d], X[b], Y[b]) < 0 ? 4 : 0;
  };
  // Stored pieces so a move only recomputes what changed (fast enough for Chromebooks).
  const vE = new Float64Array(E), vEN = new Float64Array(E * N), vCR = new Float64Array(E * E);
  let total = 0;
  function fullCost() {
    total = 0;
    for (let e = 0; e < E; e++) {
      total += (vE[e] = tEdge(e));
      for (let n = 0; n < N; n++) total += (vEN[e * N + n] = tEN(e, n));
      for (let g = e + 1; g < E; g++) total += (vCR[e * E + g] = tCR(e, g));
    }
  }
  const undo = [];
  const setV = (arr, k, v) => { undo.push(arr, k, arr[k]); total += v - arr[k]; arr[k] = v; };
  function update(moved) {                                  // moved = organism indexes that changed slot
    const hit = new Uint8Array(E);
    for (let e = 0; e < E; e++) if (moved.includes(EF[e]) || moved.includes(EE[e])) hit[e] = 1;
    for (let e = 0; e < E; e++) {
      if (hit[e]) {
        setV(vE, e, tEdge(e));
        for (let n = 0; n < N; n++) setV(vEN, e * N + n, tEN(e, n));
        for (let g = 0; g < E; g++) if (g !== e && (!hit[g] || g > e)) { const k = e < g ? e * E + g : g * E + e; setV(vCR, k, tCR(Math.min(e, g), Math.max(e, g))); }
      } else for (const m of moved) setV(vEN, e * N + m, tEN(e, m));
    }
  }
  function moveTo(i, r, c) {                                // move organism i to slot (r,c), swapping if occupied
    const j = grid[r * C + c], r0 = row[i], c0 = col[i];
    grid[r0 * C + c0] = -1;
    if (j >= 0) place(j, r0, c0);
    place(i, r, c);
    return j >= 0 ? [i, j] : [i];
  }

  // Smallest gap between any arrow and any picture it doesn't belong to (used to reject messy layouts)
  function minGap() {
    let m = 1e9;
    for (let e = 0; e < E; e++) for (let n = 0; n < N; n++) if (n !== EF[e] && n !== EE[e]) {
      const ax = X[EF[e]], ay = Y[EF[e]], bx = X[EE[e]], by = Y[EE[e]];
      m = Math.min(m, distSeg(X[n], Y[n], ax, ay, bx, by), distSeg(X[n], Y[n] + 54, ax, ay, bx, by) + 20);
    }
    return m;
  }
  let best = null;
  for (let attempt = 0; attempt < 6; attempt++) {            // random starts; keep the best (stop early when clean)
    grid.fill(-1);
    const prodCols = shuffle([...Array(C).keys()]);
    const upper = shuffle([].concat(...Array.from({ length: R - 1 }, (_, r) => Array.from({ length: C }, (_, c) => [r + 1, c]))));
    let pi = 0, ui = 0;
    for (let i = 0; i < N; i++) { if (isProd[i]) place(i, 0, prodCols[pi++]); else { place(i, upper[ui][0], upper[ui][1]); ui++; } }
    fullCost();
    let temp = 6;
    const iters = 1500 + N * 220;
    for (let k = 0; k < iters; k++) {
      const i = randInt(0, N - 1), r = isProd[i] ? 0 : randInt(1, R - 1), c = randInt(0, C - 1);
      if (r === row[i] && c === col[i]) continue;
      const r0 = row[i], c0 = col[i], before = total;
      undo.length = 0;
      update(moveTo(i, r, c));
      if (!(total <= before || Math.random() < Math.exp((before - total) / temp))) {
        moveTo(i, r0, c0);                                  // put things back...
        for (let u = undo.length - 3; u >= 0; u -= 3) undo[u][undo[u + 1]] = undo[u + 2];   // ...and the stored costs
        total = before;
      }
      temp = Math.max(0.05, temp * 0.9988);
    }
    fullCost();
    const gap = minGap();
    if (!best || (gap >= 52) > (best.gap >= 52) || ((gap >= 52) === (best.gap >= 52) && total < best.cost))
      best = { cost: total, gap, X: X.slice(), Y: Y.slice() };
    if (attempt >= 1 && best.gap >= 52) break;
  }
  // Final pixel positions, with a little wobble so it looks hand-drawn rather than a grid.
  const pos = {};
  ids.forEach((id, i) => (pos[id] = { x: best.X[i] + randInt(-6, 6), y: best.Y[i] + randInt(-6, 6) }));
  const width = PAD * 2 + (C - 1) * CW + CW / 2, height = PAD + (R - 1) * RH + 75;
  const bend = {}; web.edges.forEach(([f, e]) => (bend[f + ">" + e] = Math.random() < 0.5 ? -1 : 1));
  return { pos, width, height, bend, cost: best.cost };
}

// ---------- App state ----------
const state = {
  mode: "practice", qtype: "level", diff: "easy", lang: "en", showKey: false,
  q: null,              // the current question
  streak: 0, passed: false,
  lastWebId: null, lastTarget: null,
  trace: null,          // null = off; otherwise array of organism ids, starting at the target
  traceMsg: null,       // { key, vars, bad }
  walk: null,           // explanation highlight: { kind: "path"|"diet", path, step }
};
try {
  const saved = JSON.parse(localStorage.getItem("fw-prefs") || "{}");
  if (T[saved.lang]) state.lang = saved.lang;
  if (["easy", "medium", "hard"].includes(saved.diff)) state.diff = saved.diff;
  if (["level", "cal", "diet"].includes(saved.qtype)) state.qtype = saved.qtype;
} catch (e) { /* storage blocked: use defaults */ }
function savePrefs() { try { localStorage.setItem("fw-prefs", JSON.stringify({ lang: state.lang, diff: state.diff, qtype: state.qtype })); } catch (e) {} }

// ---------- Making questions ----------
function weightedPick(items, weightFn) {
  const ws = items.map(weightFn), tot = ws.reduce((a, b) => a + b, 0);
  let r = Math.random() * tot;
  for (let i = 0; i < items.length; i++) { r -= ws[i]; if (r <= 0) return items[i]; }
  return items[items.length - 1];
}

function newQuestion() {
  const pool = ALL_WEBS.filter((w) => (state.mode === "test" ? w.diff !== "easy" : w.diff === state.diff));
  const web = pick(pool.length > 1 ? pool.filter((w) => w.id !== state.lastWebId) : pool);
  state.lastWebId = web.id;
  const layout = layoutWeb(web);
  const q = { web, layout, type: state.qtype, tries: 0, firstTry: null, solved: false, wrongPicks: [],
              fb: null, showExpl: false, flash: null, input: "", revealed: false };
  const avoid = (id) => (id === state.lastTarget ? 0.15 : 1);

  if (q.type === "level") {
    q.target = weightedPick(web.nodes, (id) => {
      const L = web.level[id];
      if (L === 0) return 0.2 * avoid(id);
      // Favor organisms higher in the web (more arrows to count), plus "careful" ones with a shorter trap path.
      let w = L ** 1.6 + (web.minLevel[id] !== L ? 2 : 0);
      return w * avoid(id);
    });
    q.answer = web.level[q.target];
  } else if (q.type === "diet") {
    const groups = {};
    web.nodes.forEach((id) => (groups[dietOf(web, id)] = groups[dietOf(web, id)] || []).push(id));
    const kinds = Object.keys(groups).filter((k) => k !== "P" || Math.random() < 0.4);   // producers asked less often
    q.target = pick(groups[pick(kinds.length ? kinds : Object.keys(groups))]);
    q.answer = dietOf(web, q.target);
  } else {
    makeCalorieQuestion(q);
  }
  state.lastTarget = q.target;
  state.q = q; state.trace = null; state.traceMsg = null; state.walk = null;
  clearInterval(walkTimer);
  render();
  // On narrow screens the picture scrolls sideways: start with the asked-about organism in view.
  const box = $("web-box");
  if (box && box.scrollWidth > box.clientWidth) {
    const svg = $("web-svg"), scale = svg.getBoundingClientRect().width / layout.width;
    box.scrollLeft = layout.pos[q.target].x * scale - box.clientWidth / 2;
  }
}

// Calories: pick an organism (target) and another organism on its longest path (anchor).
// "up"   : anchor's calories are given, find target's  (÷10 per level)
// "down" : target's calories are given, find anchor's  (×10 per level)
// Answers are kept between 0.01 and 1,000,000 so students practice the 10% rule, not counting zeros.
const CAL_MIN = 0.01, CAL_MAX = 1000000;
const UP_START = [100, 200, 300, 500, 1000, 1500, 2000, 3000, 5000, 10000, 20000, 50000, 100000, 250000, 500000, 1000000];
const DOWN_START = [0.1, 0.2, 0.5, 1, 2, 3, 5, 7.5, 10, 25, 50, 75, 100, 230, 500, 750];
function makeCalorieQuestion(q) {
  const web = q.web;
  for (let tries = 0; tries < 200; tries++) {
    // Bigger webs: favor organisms higher up, so there are more levels to work through.
    const target = weightedPick(web.nodes.filter((id) => web.level[id] >= 1), (id) => web.level[id] ** 1.5);
    const path = pick(longestPaths(web, target));          // path[i] is at level L - i
    const L = web.level[target];
    const anchorIdx = Math.random() < 0.5 ? L : randInt(1, L);  // half the time the anchor is the producer
    const anchor = path[anchorIdx], k = anchorIdx;           // k = levels apart
    const dir = Math.random() < 0.5 ? "up" : "down";
    let given, answer;
    if (dir === "up") {
      const ok = UP_START.filter((v) => v / 10 ** k >= CAL_MIN);
      if (!ok.length) continue;
      given = pick(ok); answer = given / 10 ** k;
    } else {
      const ok = DOWN_START.filter((v) => v * 10 ** k <= CAL_MAX);
      if (!ok.length) continue;
      given = pick(ok); answer = given * 10 ** k;
    }
    if (target === state.lastTarget && tries < 20) continue;
    Object.assign(q, { target, anchor, path, dir, given, k, answer: Number(answer.toPrecision(12)) });
    return;
  }
  // Safety net (should almost never happen): a simple one-level question.
  const target = pick(web.nodes.filter((id) => web.level[id] >= 1)), path = longestPaths(web, target)[0];
  Object.assign(q, { target, anchor: path[1], path, dir: "up", given: 1000, k: 1, answer: 100 });
}

// ---------- Question text ----------
function chip(id, cls) { return `<span class="${cls}">${esc(nm(id))}</span>`; }
function questionParts(q, plain) {
  const t = tx();
  const o = plain ? nm(q.target) : chip(q.target, "org");
  if (q.type === "level") return [fill(t.levelQ, { o }), fill(t.levelSub, { o: plain ? nm(q.target) : esc(nm(q.target)) })];
  if (q.type === "diet") return [fill(t.dietQ, { o }), fill(t.dietSub, { o: plain ? nm(q.target) : esc(nm(q.target)) })];
  const a = plain ? nm(q.anchor) : chip(q.anchor, "org2");
  const n = plain ? fmtNum(q.given) : `<span class="num">${fmtNum(q.given)}</span>`;
  const anchorIsProd = q.web.level[q.anchor] === 0;
  const key = q.dir === "up" ? (anchorIsProd ? "calUpProd" : "calUp") : (anchorIsProd ? "calDownProd" : "calDown");
  return [fill(t[key], { o, a, n }), t.calSub];
}

// ---------- Drawing the food web (SVG) ----------
function iconMarkup(id, size) {
  const o = ORGS[id], h = size / 2;
  const filt = o.tint ? ` filter="url(#tint-${o.tint})"` : "";
  return `<use href="#ico-${o.icon.slice(2)}" x="${-h}" y="${-h}" width="${size}" height="${size}"${filt}/>`;
}
function labelLines(s) {
  if (s.length <= 14 || !s.includes(" ")) return [s];
  // split at the space closest to the middle
  let best = -1;
  for (let i = 0; i < s.length; i++) if (s[i] === " " && (best < 0 || Math.abs(i - s.length / 2) < Math.abs(best - s.length / 2))) best = i;
  return [s.slice(0, best), s.slice(best + 1)];
}
// How far from an organism's center an arrow must stop so it doesn't hide under the picture or its name tag.
// The organism is a circle (radius 40) with a name tag (box) underneath.
function exitDist(ux, uy, box) {
  let d = 40;
  // ray from the center vs. the label box [-hw, hw] x [top, bottom]
  let tmin = -Infinity, tmax = Infinity;
  const slab = (u, lo, hi) => {
    if (Math.abs(u) < 1e-9) { if (lo > 0 || hi < 0) { tmin = Infinity; } return; }
    let t1 = lo / u, t2 = hi / u; if (t1 > t2) [t1, t2] = [t2, t1];
    tmin = Math.max(tmin, t1); tmax = Math.min(tmax, t2);
  };
  slab(ux, -box.hw, box.hw); slab(uy, box.top, box.bottom);
  if (tmin <= tmax && tmax > 0) d = Math.max(d, tmax);
  return d;
}
function edgePath(a, b, sign, boxA, boxB) {
  const dx = b.x - a.x, dy = b.y - a.y, len = Math.hypot(dx, dy), ux = dx / len, uy = dy / len;
  const ds = exitDist(ux, uy, boxA) + 5, de = exitDist(-ux, -uy, boxB) + 9;
  const s = { x: a.x + ux * ds, y: a.y + uy * ds }, e = { x: b.x - ux * de, y: b.y - uy * de };
  const L = Math.hypot(e.x - s.x, e.y - s.y);
  const off = Math.min(26, L * 0.12) * sign;
  const cx = (s.x + e.x) / 2 - uy * off, cy = (s.y + e.y) / 2 + ux * off;
  return `M${s.x.toFixed(1)},${s.y.toFixed(1)} Q${cx.toFixed(1)},${cy.toFixed(1)} ${e.x.toFixed(1)},${e.y.toFixed(1)}`;
}
function nodeBox(id) {
  const lines = labelLines(nm(id));
  const lw = Math.max(...lines.map((l) => l.length)) * 8.6 + 16, lh = lines.length * 18 + 6;
  return { lines, lw, lh, hw: lw / 2, top: 40, bottom: 40 + lh };
}

function webSVG() {
  const q = state.q, web = q.web, L = q.layout, t = tx();
  // What to highlight right now
  const onNodes = new Set(), onEdges = new Set(), foodEdges = new Set(), badges = {};
  let dimOthers = false;
  if (state.walk) {
    const w = state.walk;
    if (w.kind === "path") {
      const shown = w.path.slice(0, w.step + 1);
      shown.forEach((id, i) => { onNodes.add(id); badges[id] = { text: w.labels[i], cls: "" }; if (i > 0) onEdges.add(id + ">" + shown[i - 1]); });
      dimOthers = true;
    } else {
      web.foods[q.target].slice(0, w.step).forEach((f) => {
        foodEdges.add(f + ">" + q.target); onNodes.add(f);
        badges[f] = { text: web.level[f] === 0 ? t.tagProducer : t.tagAnimal, cls: "food" };
      });
      dimOthers = true;
    }
  }
  if (state.trace) {
    state.trace.forEach((id, i) => { onNodes.add(id); if (i > 0) { onEdges.add(id + ">" + state.trace[i - 1]); badges[id] = { text: String(i), cls: "" }; } });
  }
  const missId = state.traceMsg && state.traceMsg.bad ? state.traceMsg.missId : null;

  let s = `<svg id="web-svg" class="web-svg ${state.trace ? "tracing" : ""}" viewBox="0 0 ${L.width} ${L.height}" role="img"
    aria-label="${esc(ECOS[web.eco][state.lang])} food web: ${web.nodes.map(nm).map(esc).join(", ")}">`;
  s += `<defs>${["arrow", "on", "food"].map((k) => `<marker id="ah-${k}" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="${k === "arrow" ? 5.5 : 4}" markerHeight="${k === "arrow" ? 5.5 : 4}" orient="auto-start-reverse"><path class="arrowhead ${k === "arrow" ? "" : k}" d="M0,0 L10,5 L0,10 z"/></marker>`).join("")}</defs>`;
  const boxes = {}; for (const id of web.nodes) boxes[id] = nodeBox(id);
  // Arrows first (so pictures sit on top)
  for (const [f, e] of web.edges) {
    const key = f + ">" + e;
    const cls = foodEdges.has(key) ? "food" : onEdges.has(key) ? "on" : dimOthers || (state.trace && state.trace.length > 1) ? "dim" : "";
    const mk = cls === "food" ? "food" : cls === "on" ? "on" : "arrow";
    s += `<path class="edge ${cls}" d="${edgePath(L.pos[f], L.pos[e], L.bend[key], boxes[f], boxes[e])}" marker-end="url(#ah-${mk})"/>`;
  }
  // Organisms
  for (const id of web.nodes) {
    const p = L.pos[id];
    const isTarget = id === q.target, isOther = q.type === "cal" && id === q.anchor;
    const cls = [isTarget ? "target" : "", isOther ? "other" : "", onNodes.has(id) && !isTarget ? "on" : "",
                 dimOthers && !onNodes.has(id) && !isTarget && !isOther ? "dim" : "", id === missId ? "miss" : ""].join(" ");
    const { lines, lw, lh } = boxes[id];
    s += `<g class="node ${cls}" data-id="${id}" transform="translate(${p.x},${p.y})" ${state.trace ? `tabindex="0" role="button" aria-label="${esc(nm(id))}"` : ""}>
      <circle class="disc" r="38"/>${iconMarkup(id, 52)}
      <rect class="lbl-bg" x="${-lw / 2}" y="40" width="${lw}" height="${lh}" rx="8"/>
      ${lines.map((l, i) => `<text class="lbl" text-anchor="middle" y="${57 + i * 18}">${esc(l)}</text>`).join("")}`;
    if (badges[id]) {
      const bt = badges[id].text, bw = bt.length * 9 + 14;
      s += `<g class="badge ${badges[id].cls}" transform="translate(${26 - bw / 2 + 10},-50)"><rect width="${bw}" height="24" rx="12"/><text x="${bw / 2}" y="17" text-anchor="middle">${esc(bt)}</text></g>`;
    }
    s += `</g>`;
