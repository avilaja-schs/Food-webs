<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<!-- Food Web Detective — single-file page. To update: replace this file in the GitHub repo. -->
<style>[hidden]{display:none!important} img{max-width:100%}</style>
<title>Food Web Detective</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lexend:wght@400;500;700&family=JetBrains+Mono:wght@500;700&display=swap&subset=vietnamese">
<style>
/* Layout: food web picture on the left (main), tools (key + calculator) on the right; stacks on phones.
   Colors match the sibling tool "Density Detective" so the two feel like one set. */
:root {
  --bg: #eaf2f3; --surface: #ffffff; --ink: #10303b; --muted: #557481; --line: #c6d9de; --chip: #deecef;
  --accent: #0a7584; --accent-ink: #ffffff;
  --cover: #f4a23c; --cover-ink: #2b1700;       /* buoy orange: the organism being asked about */
  --path: #7a3cc4;                               /* purple: the traced / explained path */
  --arrow: #6c8791;
  --web-bg: #f7fbfb;
  --good: #1d7f47; --good-bg: #d4f1df; --bad: #b8352a; --bad-bg: #fbdfda;
  --font-body: "Lexend", "Segoe UI", system-ui, sans-serif;
  --font-num: "JetBrains Mono", ui-monospace, "Consolas", monospace;
  --radius: 12px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0b1b21; --surface: #11262e; --ink: #e2eff2; --muted: #8fb0ba; --line: #24434d; --chip: #19343d;
    --accent: #3ec1d0; --accent-ink: #04232a; --cover: #f2a33a; --cover-ink: #2b1700; --path: #c49bff;
    --arrow: #7f9ea8; --web-bg: #0f2229;
    --good: #5bd894; --good-bg: #123a26; --bad: #ff8576; --bad-bg: #3f1b17; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0b1b21; --surface: #11262e; --ink: #e2eff2; --muted: #8fb0ba; --line: #24434d; --chip: #19343d;
  --accent: #3ec1d0; --accent-ink: #04232a; --cover: #f2a33a; --cover-ink: #2b1700; --path: #c49bff;
  --arrow: #7f9ea8; --web-bg: #0f2229;
  --good: #5bd894; --good-bg: #123a26; --bad: #ff8576; --bad-bg: #3f1b17; color-scheme: dark;
}

* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font-body); font-size: 16px; line-height: 1.5; }
.wrap {
  max-width: 1240px; margin: 0 auto; padding-inline: 16px; padding-block: 20px 48px;
  display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr) 320px;
  grid-template-areas: "head head" "controls controls" "main side" "foot foot"; align-items: start;
}
.wrap.noside { grid-template-columns: minmax(0, 1fr); grid-template-areas: "head" "controls" "main" "foot"; }
.wrap.noside .side { display: none; }
header { grid-area: head; }
h1 { font-size: clamp(1.6rem, 3.5vw, 2.2rem); margin: 0; letter-spacing: -0.02em; line-height: 1.15; }
.tagline { margin: 6px 0 0; color: var(--muted); max-width: 70ch; }

/* ---------- Control bar ---------- */
.controls { grid-area: controls; display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: end;
  background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 12px 14px; }
.ctrl { display: flex; flex-direction: column; gap: 4px; }
.ctrl-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 500; }
.seg { display: inline-flex; flex-wrap: wrap; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; background: var(--bg); }
.seg button { border: 0; background: transparent; color: var(--ink); font: inherit; font-size: 0.92rem; padding: 7px 14px; cursor: pointer; min-height: 38px; }
.seg button + button { border-left: 1px solid var(--line); }
.seg button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); font-weight: 500; }
.seg button:disabled { opacity: 0.45; cursor: not-allowed; }
.btn { border: 1px solid var(--accent); background: var(--accent); color: var(--accent-ink); font: inherit; font-weight: 500;
  padding: 8px 16px; border-radius: 999px; cursor: pointer; min-height: 40px; }
.btn.ghost { background: transparent; color: var(--accent); }
.btn.small { min-height: 34px; padding: 5px 12px; font-size: 0.88rem; }
.btn:disabled { opacity: 0.45; cursor: not-allowed; }
.push { margin-left: auto; }
button:focus-visible, input:focus-visible { outline: 3px solid var(--cover); outline-offset: 2px; }

/* ---------- Main column ---------- */
main { grid-area: main; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.banner { background: var(--chip); border-radius: var(--radius); padding: 10px 14px; font-weight: 500; }
.banner.win { background: var(--good-bg); color: var(--good); }
.streak { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.dots { display: inline-flex; gap: 6px; }
.dot { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--accent); background: transparent; }
.dot.on { background: var(--accent); }

.card { background: var(--surface); border: 2px solid var(--line); border-radius: var(--radius); padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.card.solved { border-color: var(--good); }
.card-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.card-head h2 { margin: 0; font-size: 1.05rem; }
.eco-tag { font-size: 0.8rem; color: var(--muted); }
.speak { margin-left: auto; border: 1px solid var(--line); background: transparent; color: var(--ink); border-radius: 999px; padding: 5px 12px; font: inherit; font-size: 0.85rem; cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
.speak svg { width: 16px; height: 16px; }
.qtext { margin: 0; font-size: 1.12rem; max-width: 70ch; }
.qtext .org { background: var(--cover); color: var(--cover-ink); padding: 0 8px; border-radius: 6px; font-weight: 700; white-space: nowrap; }
.qtext .org2 { background: var(--chip); border: 2px dashed var(--accent); padding: 0 6px; border-radius: 6px; font-weight: 700; white-space: nowrap; }
.qtext .num { font-family: var(--font-num); font-weight: 700; background: var(--chip); padding: 0 6px; border-radius: 6px; white-space: nowrap; }
.qsub { margin: 0; color: var(--muted); font-size: 0.92rem; }

/* Food web picture */
.web-box { background: var(--web-bg); border: 1px solid var(--line); border-radius: 10px; overflow-x: auto; overflow-y: hidden; }
.web-svg { display: block; width: 100%; height: auto; min-width: 600px; }
.web-svg .edge { fill: none; stroke: var(--arrow); stroke-width: 2.4; }
.web-svg .edge.on { stroke: var(--path); stroke-width: 5; }
.web-svg .edge.food { stroke: var(--cover); stroke-width: 5; }
.web-svg .edge.dim { opacity: 0.25; }
.web-svg .node { cursor: default; }
.web-svg.tracing .node { cursor: pointer; }
.web-svg .node .disc { fill: var(--surface); stroke: var(--line); stroke-width: 2; }
.web-svg .node .lbl-bg { fill: var(--surface); stroke: var(--line); stroke-width: 1; }
.web-svg .node .lbl { fill: var(--ink); font-family: var(--font-body); font-size: 15px; font-weight: 500; }
.web-svg .node.target .disc { stroke: var(--cover); stroke-width: 6; }
.web-svg .node.target .lbl-bg { fill: var(--cover); stroke: var(--cover); }
.web-svg .node.target .lbl { fill: var(--cover-ink); font-weight: 700; }
.web-svg .node.other .disc { stroke: var(--accent); stroke-width: 5; stroke-dasharray: 6 4; }
.web-svg .node.on .disc { stroke: var(--path); stroke-width: 6; }
.web-svg .node.dim { opacity: 0.35; }
.web-svg .node.miss .disc { stroke: var(--bad); stroke-width: 6; }
.web-svg .badge rect { fill: var(--path); }
.web-svg .badge text { fill: #fff; font-family: var(--font-num); font-size: 15px; font-weight: 700; }
.web-svg .badge.food rect { fill: var(--cover); }
.web-svg .badge.food text { fill: var(--cover-ink); font-family: var(--font-body); }
@keyframes pulse { 0%,100% { stroke-opacity: 1; } 50% { stroke-opacity: 0.35; } }
.web-svg .node.target .disc { animation: pulse 1.6s ease-in-out infinite; }
.web-svg .arrowhead { fill: var(--arrow); }
.web-svg .arrowhead.on { fill: var(--path); }
.web-svg .arrowhead.food { fill: var(--cover); }

/* Trace tool */
.trace-bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.trace-msg { font-size: 0.92rem; min-height: 1.4em; }
.trace-msg.bad { color: var(--bad); }
.trace-count { font-family: var(--font-num); font-weight: 700; background: var(--chip); border-radius: 6px; padding: 1px 8px; }
.scroll-tip { font-size: 0.8rem; color: var(--muted); margin: 0; display: none; }

/* Answer area */
.levels { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
.choice { border: 2px solid var(--line); background: var(--bg); color: var(--ink); font: inherit; border-radius: 10px; cursor: pointer;
  padding: 8px 4px; min-height: 56px; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.15; }
.choice .big { font-family: var(--font-num); font-size: 1.3rem; font-weight: 700; }
.choice .small { font-size: 0.75rem; color: var(--muted); }
.choice:hover:not(:disabled) { border-color: var(--accent); }
.choice.picked-bad { border-color: var(--bad); background: var(--bad-bg); }
.choice.picked-good { border-color: var(--good); background: var(--good-bg); }
.choice:disabled { cursor: not-allowed; }
.diets { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.diets .big { font-family: var(--font-body); }
.answer-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; }
.field { display: flex; flex-direction: column; gap: 3px; }
.field label { font-size: 0.78rem; color: var(--muted); }
.field input { font: inherit; font-family: var(--font-num); font-size: 1.15rem; padding: 8px 10px; border: 2px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); min-height: 46px; width: 12rem; }
.unit-lbl { font-weight: 500; padding-bottom: 10px; }
.feedback { min-height: 1.5em; margin: 0; font-weight: 500; }
.feedback.good { color: var(--good); }
.feedback.bad { color: var(--bad); }
.feedback .hint { display: block; font-weight: 400; color: var(--ink); }
.next-row { display: flex; gap: 10px; flex-wrap: wrap; }

@keyframes flashGood { 0%,100% { background: var(--surface); } 25%,60% { background: var(--good-bg); } }
@keyframes flashBad { 0%,100% { background: var(--surface); } 25%,60% { background: var(--bad-bg); } }
@keyframes shake { 0%,100% { transform: none; } 20% { transform: translateX(-6px); } 40% { transform: translateX(6px); } 60% { transform: translateX(-4px); } 80% { transform: translateX(4px); } }
.flash-good { animation: flashGood 0.9s ease; border-color: var(--good); }
.flash-bad { animation: flashBad 0.9s ease, shake 0.4s ease; border-color: var(--bad); }

/* Explanation */
.expl { border-top: 1px dashed var(--line); padding-top: 10px; }
.expl h3 { margin: 0 0 6px; font-size: 0.98rem; }
.expl p { margin: 4px 0; }
.expl .chain { font-weight: 500; }
.expl .note { color: var(--muted); font-size: 0.92rem; }
.expl table { border-collapse: collapse; margin: 6px 0; font-size: 0.95rem; }
.expl td, .expl th { border: 1px solid var(--line); padding: 4px 10px; text-align: left; }
.expl td.n { font-family: var(--font-num); text-align: right; }
.expl tr.hl td { background: var(--chip); font-weight: 700; }

/* ---------- Side tools ---------- */
.side { grid-area: side; display: flex; flex-direction: column; gap: 16px; min-width: 0; }
.tool { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px; }
.tool h2 { margin: 0 0 8px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
.key dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 6px 10px; font-size: 0.92rem; }
.key dt { font-weight: 700; }
.key dd { margin: 0; }
.key .arrow-demo { display: flex; align-items: center; gap: 8px; margin: 10px 0; font-size: 0.92rem; }
.key .off { font-size: 0.88rem; color: var(--muted); margin: 0; }
.key table { border-collapse: collapse; font-size: 0.88rem; margin-top: 8px; width: 100%; }
.key td { border-top: 1px solid var(--line); padding: 3px 4px; }
.key td.n { font-family: var(--font-num); text-align: right; }
.calc-display { font-family: var(--font-num); background: var(--bg); border: 2px solid var(--line); border-radius: 8px; padding: 8px 10px; text-align: right; min-height: 64px; display: flex; flex-direction: column; justify-content: center; overflow: hidden; }
.calc-expr { font-size: 0.85rem; color: var(--muted); min-height: 1.2em; word-break: break-all; }
.calc-val { font-size: 1.5rem; font-weight: 700; word-break: break-all; }
.keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 8px; }
.keys button { font-family: var(--font-num); font-size: 1.15rem; padding: 10px 0; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); cursor: pointer; min-height: 46px; }
.keys button.op { background: var(--chip); font-weight: 700; }
.keys button.eq { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 700; }
.keys button.use { grid-column: span 2; font-family: var(--font-body); font-size: 0.9rem; }
.calc-tip { font-size: 0.78rem; color: var(--muted); margin: 6px 0 0; }

footer { grid-area: foot; font-size: 0.8rem; color: var(--muted); }
footer details { margin-top: 8px; }
footer summary { cursor: pointer; font-weight: 500; color: var(--ink); }
footer ul { padding-left: 18px; margin: 6px 0; }
footer a { color: var(--accent); word-break: break-all; }

#confetti { position: fixed; inset: 0; pointer-events: none; z-index: 50; }

@media (max-width: 900px) {
  .wrap { grid-template-columns: minmax(0, 1fr); grid-template-areas: "head" "controls" "main" "side" "foot"; }
  .push { margin-left: 0; }
  .scroll-tip { display: block; }
}
@media (max-width: 520px) {
  .levels { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 5px; }
  .choice .small { font-size: 0.62rem; }
  .diets { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .seg button { padding: 7px 10px; }
}
@media (prefers-reduced-motion: reduce) {
  .flash-good { animation: none; background: var(--good-bg); }
  .flash-bad { animation: none; background: var(--bad-bg); }
  .web-svg .node.target .disc { animation: none; }
}
</style>

</head>
